# ==============================================================================
# Position Sizing System Configuration (.env.example)
# ==============================================================================

# 天勤量化 (TqSdk) 凭据 (请填入您自己的天勤账号密码)
TQ_ACCOUNT=your_tq_account
TQ_PASSWORD=your_tq_password

# 数据源与缓存配置
TQ_AUTO_SYNC=true
TQ_CACHE_FILE=backend/data/tq_cache.json
